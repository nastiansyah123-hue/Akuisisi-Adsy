{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/team-message.js": {
      "maxDuration": 30
    },
    "api/laporan-bridge.js": {
      "maxDuration": 30
    }
  }
}
